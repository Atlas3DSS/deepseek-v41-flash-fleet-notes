 #include <algorithm>
 #include <atomic>
 #include <thread>
+#include <map>
+#include <chrono>
+
+// dsv41 2026-10-17 diagnostic (env RPC_STATS=N): per-token traffic accounting on the client. Logs every N graph
+// computes: hits/misses of the graph cache, bytes serialised, bytes set/got per device and the top tensors by bytes.
+// dsv41 diagnostic (env RPC_SERVER_STATS=N): server-side time per command class, printed every N graph computes.
+namespace rpc_srv_stats {
+    static int every() { static int n = [] { const char * e = getenv("RPC_SERVER_STATS"); return e ? atoi(e) : 0; }(); return n; }
+    static std::mutex mu;
+    static uint64_t n_compute = 0;
+    static std::map<std::pair<uint32_t, int>, std::pair<uint64_t, uint64_t>> acc; // (device, kind) -> (count, ns); kind 0=compute 1=copy 2=get 3=set
+    static void add(uint32_t device, int kind, uint64_t ns) {
+        if (!every()) return;
+        std::lock_guard<std::mutex> l(mu);
+        auto & a = acc[{device, kind}]; a.first++; a.second += ns;
+        if (kind == 0 && ++n_compute % every() == 0) {
+            static const char * names[] = {"compute", "copy", "get", "set"};
+            for (auto & kv : acc) {
+                GGML_LOG_WARN("[rpc_srv_stats] dev=%u %-7s n=%5llu %9.1f ms (avg %.3f ms)\n", kv.first.first, names[kv.first.second],
+                    (unsigned long long) kv.second.first, kv.second.second / 1e6, kv.second.second / 1e6 / std::max<uint64_t>(1, kv.second.first));
+            }
+            acc.clear();
+        }
+    }
+    struct timer {
+        uint32_t dev; int kind; std::chrono::steady_clock::time_point t0;
+        timer(uint32_t d, int k) : dev(d), kind(k), t0(std::chrono::steady_clock::now()) {}
+        ~timer() { if (every()) add(dev, kind, std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count()); }
+    };
+}
+
+namespace rpc_stats {
+    static int every() { static int n = [] { const char * e = getenv("RPC_STATS"); return e ? atoi(e) : 0; }(); return n; }
+    static std::mutex mu;
+    static uint64_t n_graph = 0, n_hit = 0, n_miss = 0, graph_bytes = 0, set_bytes = 0, get_bytes = 0, cpy_n = 0, n_set = 0, n_get = 0;
+    static std::map<std::string, uint64_t> by_name;
+    static void add(const char * kind, const ggml_tensor * t, size_t size) {
+        if (!every()) return;
+        std::lock_guard<std::mutex> l(mu);
+        if (kind[0] == 's') { set_bytes += size; n_set++; } else { get_bytes += size; n_get++; }
+        by_name[std::string(kind) + ":" + t->name] += size;
+    }
+    // blocking time inside synchronous sends, per (dispatcher, command): how long the compute thread waits on each
+    // server (queue backlog + network + remote processing)
+    static std::map<std::pair<const void *, int>, std::pair<uint64_t, uint64_t>> waits; // -> (count, ns)
+    static std::map<const void *, std::string> disp_names;
+    static void wait(const void * disp, int cmd, uint64_t ns) {
+        if (!every()) return;
+        std::lock_guard<std::mutex> l(mu);
+        auto & w = waits[{disp, cmd}]; w.first++; w.second += ns;
+    }
+    static void graph(bool hit, size_t bytes) {
+        if (!every()) return;
+        std::lock_guard<std::mutex> l(mu);
+        n_graph++; if (hit) n_hit++; else { n_miss++; graph_bytes += bytes; }
+        if (n_graph % every() == 0) {
+            for (auto & kv : waits) {
+                auto dn = disp_names.find(kv.first.first);
+                GGML_LOG_WARN("[rpc_stats]   wait %-28s cmd=%2d n=%4llu %8.1f ms\n", dn != disp_names.end() ? dn->second.c_str() : "?",
+                    kv.first.second, (unsigned long long) kv.second.first, kv.second.second / 1e6);
+            }
+            waits.clear();
+            GGML_LOG_WARN("[rpc_stats] graphs=%llu hit=%llu miss=%llu graph_bytes=%.1fMB set=%llu/%.1fMB get=%llu/%.1fMB cpy=%llu\n",
+                (unsigned long long)n_graph, (unsigned long long)n_hit, (unsigned long long)n_miss, graph_bytes/1e6,
+                (unsigned long long)n_set, set_bytes/1e6, (unsigned long long)n_get, get_bytes/1e6, (unsigned long long)cpy_n);
+            std::vector<std::pair<uint64_t,std::string>> v; for (auto & kv : by_name) v.push_back({kv.second, kv.first});
+            std::sort(v.rbegin(), v.rend());
+            for (size_t i = 0; i < v.size() && i < 12; i++) GGML_LOG_WARN("[rpc_stats]   %-40s %.1f MB\n", v[i].second.c_str(), v[i].first/1e6);
+            n_hit = n_miss = graph_bytes = set_bytes = get_bytes = cpy_n = n_set = n_get = 0; by_name.clear();
+        }
+    }
+}
 
