 // GEMV for 8x blocks of 32 4-bit quants with a single scale factor per block
+
+#if defined(__AVX2__)
+// vector E8M0 -> fp32 (half) scale conversion for MXFP4 blocks. Bit-identical to
+// ggml_e8m0_to_fp32_half(): x < 2 -> 0x00200000 << x (denormals), else (x - 1) << 23. Replaces 8 (16) scalar table
+// lookups + _mm256_set_ps per 32-block on the gemv/gemm hot path.
+static inline __m256i mxfp4_e8m0x8_to_f32_half_bits(const uint8_t * e) {
+    const __m256i x    = _mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) e));
+    const __m256i one  = _mm256_set1_epi32(1);
+    const __m256i big  = _mm256_slli_epi32(_mm256_sub_epi32(x, one), 23);
+    const __m256i tiny = _mm256_sllv_epi32(_mm256_set1_epi32(0x00200000), x);
+    return _mm256_blendv_epi8(tiny, big, _mm256_cmpgt_epi32(x, one));
+}
+// natural lane order: lane i = e[i]
+static inline __m256 mxfp4_e8m0x8_to_f32_half(const uint8_t * e) {
+    return _mm256_castsi256_ps(mxfp4_e8m0x8_to_f32_half_bits(e));
+}
+// gemv lane order e0,e4,e1,e5,e2,e6,e3,e7 (matches the interleaved accumulator layout)
+static inline __m256 mxfp4_e8m0x8_to_f32_half_gemv(const uint8_t * e) {
+    return _mm256_castsi256_ps(_mm256_permutevar8x32_epi32(mxfp4_e8m0x8_to_f32_half_bits(e), _mm256_setr_epi32(0, 4, 1, 5, 2, 6, 3, 7)));
+}
+#endif
+#if defined(__AVX512F__)
+// lanes 0-7 = e0[0..7], lanes 8-15 = e1[0..7]
+static inline __m512 mxfp4_e8m0x16_to_f32_half(const uint8_t * e0, const uint8_t * e1) {
+    const __m128i raw  = _mm_unpacklo_epi64(_mm_loadl_epi64((const __m128i *) e0), _mm_loadl_epi64((const __m128i *) e1));
+    const __m512i x    = _mm512_cvtepu8_epi32(raw);
+    const __m512i one  = _mm512_set1_epi32(1);
+    const __m512i big  = _mm512_slli_epi32(_mm512_sub_epi32(x, one), 23);
+    const __m512i tiny = _mm512_sllv_epi32(_mm512_set1_epi32(0x00200000), x);
+    const __mmask16 m  = _mm512_cmpgt_epi32_mask(x, one);
+    return _mm512_castsi512_ps(_mm512_mask_blend_epi32(m, tiny, big));
+}
+#endif
